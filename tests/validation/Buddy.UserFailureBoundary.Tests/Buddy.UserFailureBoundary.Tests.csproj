<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <BuddySourceRoot Condition="'$(BuddySourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\</BuddySourceRoot>
    <BuddyWindowRoot Condition="'$(BuddyWindowRoot)' == ''">$(BuddySourceRoot)</BuddyWindowRoot>
    <BuddyControlRoot Condition="'$(BuddyControlRoot)' == ''">$(BuddySourceRoot)</BuddyControlRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BuddySourceRoot)services\Buddy.Server\*.cs" Link="Production\%(Filename)%(Extension)" />
    <Compile Include="$(BuddyWindowRoot)apps\windows\Buddy.Windows\WindowSelection.cs" Link="Production\WindowSelection.cs" />
    <Compile Include="$(BuddyControlRoot)apps\windows\Buddy.Windows\BoundedComputerUse.cs" Link="Production\BoundedComputerUse.cs" />
    <Compile Include="$(BuddyControlRoot)apps\windows\Buddy.Windows\RoutineAppOpen.cs" Link="Production\RoutineAppOpen.cs" />
    <Compile Include="$(BuddyControlRoot)apps\windows\Buddy.Windows\AppFrameBinding.cs" Link="Production\AppFrameBinding.cs" />
    <Compile Include="$(BuddyControlRoot)apps\windows\Buddy.Windows\FixedFrameHostTrust.cs" Link="Production\FixedFrameHostTrust.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" /><PackageReference Include="AngleSharp" Version="1.8.2" />
    <AssemblyMetadata Include="BuddySourceRoot" Value="$([System.IO.Path]::GetFullPath('$(BuddySourceRoot)'))" />
  </ItemGroup>
  <Import Project="ReviewedSource.targets" />
</Project>
