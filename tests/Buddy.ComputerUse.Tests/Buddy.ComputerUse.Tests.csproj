    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>disable</ImplicitUsings>
    <BuddyWindowRoot Condition="'$(BuddyWindowRoot)' == ''">$(MSBuildThisFileDirectory)../../apps/windows/Buddy.Windows</BuddyWindowRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../services/Buddy.Server/Buddy.Server.csproj" />
    <Compile Include="../../apps/windows/Buddy.Windows/BoundedComputerUse.cs" Link="BoundedComputerUse.cs" />
    <Compile Include="../../apps/windows/Buddy.Windows/RoutineAppOpen.cs" Link="RoutineAppOpen.cs" />
    <Compile Include="../../apps/windows/Buddy.Windows/AppFrameBinding.cs" Link="AppFrameBinding.cs" />
    <Compile Include="../../apps/windows/Buddy.Windows/FixedFrameHostTrust.cs" Link="FixedFrameHostTrust.cs" />
    <Compile Include="../../apps/windows/Buddy.Windows/InstalledAppResolver.cs" Link="InstalledAppResolver.cs" />
    <Compile Include="../../apps/windows/Buddy.Windows/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="$(BuddyWindowRoot)/WindowSelection.cs" Link="WindowSelection.cs" />
    <Compile Include="$(BuddyWindowRoot)/InputNative.cs" Link="InputNative.cs" />
    <Compile Include="$(BuddyWindowRoot)/Native.cs" Link="Native.cs" />
    <Compile Include="../Buddy.Windows.IntegrationTests/ComputerUseChecks.cs" Link="ComputerUseChecks.cs" />
  </ItemGroup>
</Project>
