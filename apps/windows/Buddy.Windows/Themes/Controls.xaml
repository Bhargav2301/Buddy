<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every content surface is opaque. Ring and gap are three device-independent pixels each. -->
    <Style TargetType="{x:Type Window}"><Setter Property="Background" Value="{DynamicResource Buddy.Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="FontFamily" Value="{DynamicResource Buddy.Font}"/></Style>
    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{DynamicResource Buddy.Font}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="{DynamicResource Buddy.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
        <Border x:Name="focusRing" BorderThickness="3" CornerRadius="18" BorderBrush="Transparent">
            <Border x:Name="focusGap" BorderThickness="3" CornerRadius="15" BorderBrush="Transparent">
                <Border x:Name="frame" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="content" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.Pressed}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/><Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Buddy.PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Buddy.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.OnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ActionBorder}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
        <Border x:Name="focusRing" BorderThickness="3" CornerRadius="18" BorderBrush="Transparent">
            <Border x:Name="focusGap" BorderThickness="3" CornerRadius="15" BorderBrush="Transparent">
                <Border x:Name="frame" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="content" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.ActionHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.ActionPressed}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/><Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="Background" Value="{DynamicResource Buddy.Input}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter Property="SelectionBrush" Value="{DynamicResource Buddy.SelectionSurface}"/><Setter Property="SelectionTextBrush" Value="{DynamicResource Buddy.SelectionText}"/><Setter Property="SelectionOpacity" Value="1"/>
        <Setter Property="Padding" Value="10,8"/><Setter Property="FontFamily" Value="{DynamicResource Buddy.Font}"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="44"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="focusRing" BorderThickness="3" CornerRadius="14" BorderBrush="Transparent"><Border x:Name="focusGap" BorderThickness="3" CornerRadius="11" BorderBrush="Transparent">
                <!-- TextBox supplies its padding to the content host. Applying it as Margin too clips the text viewport. -->
                <Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
            </Border></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger>
                <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Buddy.ErrorBorder}"/><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.RiskSoft}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{DynamicResource Buddy.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="focusRing" BorderThickness="3" BorderBrush="Transparent"><Border x:Name="focusGap" BorderThickness="3" BorderBrush="Transparent">
                <Border x:Name="frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="content" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
            </Border></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.Hover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.SelectionSurface}"/><Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource Buddy.SelectionText}"/></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/><Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource Buddy.Input}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource Buddy.Font}"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
                <Border x:Name="focusRing" BorderThickness="3" CornerRadius="14" BorderBrush="Transparent"><Border x:Name="focusGap" BorderThickness="3" CornerRadius="11" BorderBrush="Transparent">
                    <Grid><ToggleButton x:Name="toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}">
                        <ToggleButton.Template><ControlTemplate TargetType="{x:Type ToggleButton}"><Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.Hover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.Pressed}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}" Margin="12,8,38,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="0,0,30,0" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                    </Grid>
                </Border></Border>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="False" PopupAnimation="None">
                    <Border x:Name="popupSurface" Background="{DynamicResource Buddy.Surface}" TextElement.Foreground="{DynamicResource Buddy.Ink}" BorderBrush="{DynamicResource Buddy.ControlBorder}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer Margin="3" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="selection" Property="Visibility" Value="Hidden"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger>
                <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="toggle" Property="BorderBrush" Value="{DynamicResource Buddy.ErrorBorder}"/><Setter TargetName="toggle" Property="Background" Value="{DynamicResource Buddy.RiskSoft}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="MinHeight" Value="44"/><Setter Property="FontFamily" Value="{DynamicResource Buddy.Font}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type CheckBox}">
            <Border x:Name="focusRing" BorderThickness="3" CornerRadius="10" BorderBrush="Transparent"><Border x:Name="focusGap" BorderThickness="3" CornerRadius="7" BorderBrush="Transparent"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="box" Width="22" Height="22" Background="{DynamicResource Buddy.Input}" BorderBrush="{DynamicResource Buddy.ControlBorder}" BorderThickness="1" CornerRadius="4"><Grid><Path x:Name="check" Visibility="Collapsed" Data="M 3 10 L 8 15 L 18 4" Stroke="{DynamicResource Buddy.SelectionText}" StrokeThickness="2"/><Rectangle x:Name="mixed" Visibility="Collapsed" Fill="{DynamicResource Buddy.SelectionText}" Height="3" Margin="4"/></Grid></Border>
                <ContentPresenter x:Name="content" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
            </Grid></Border></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource Buddy.Hover}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource Buddy.SelectionSurface}"/><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="box" Property="Background" Value="{DynamicResource Buddy.SelectionSurface}"/><Setter TargetName="mixed" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/><Setter TargetName="check" Property="Stroke" Value="{DynamicResource Buddy.DisabledText}"/><Setter TargetName="mixed" Property="Fill" Value="{DynamicResource Buddy.DisabledText}"/><Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Buddy.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="{DynamicResource Buddy.Font}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ContextMenu}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="4"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="{DynamicResource Buddy.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type MenuItem}">
            <Grid><Border x:Name="focusRing" BorderThickness="3" BorderBrush="Transparent"><Border x:Name="focusGap" BorderThickness="3" BorderBrush="Transparent"><Border x:Name="frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                <ContentPresenter x:Name="icon" Content="{TemplateBinding Icon}"/>
                <TextBlock x:Name="check" Text="✓" Visibility="Collapsed" Foreground="{DynamicResource Buddy.Deep}"/>
                <ContentPresenter x:Name="content" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{TemplateBinding Foreground}" Margin="16,0,0,0"/>
                <Path x:Name="arrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid></Border></Border></Border>
            <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="False" Focusable="False" PopupAnimation="None"><Border Background="{DynamicResource Buddy.Surface}" TextElement.Foreground="{DynamicResource Buddy.Ink}" BorderBrush="{DynamicResource Buddy.ControlBorder}" BorderThickness="1" Padding="4"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="True"><Setter TargetName="arrow" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="check" Property="Visibility" Value="Visible"/><Setter TargetName="icon" Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.Hover}"/><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.DisabledText}"/><Setter TargetName="check" Property="Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="{DynamicResource Buddy.Raised}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/><Setter Property="Padding" Value="10"/></Style>
    <Style TargetType="{x:Type ListBox}"><Setter Property="Background" Value="{DynamicResource Buddy.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ListBox}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="{DynamicResource Buddy.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="44"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="focusRing" BorderThickness="3" CornerRadius="10" BorderBrush="Transparent"><Border x:Name="focusGap" BorderThickness="3" CornerRadius="7" BorderBrush="Transparent"><Border x:Name="frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter x:Name="content" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></Border></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.Hover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.SelectionSurface}"/><Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource Buddy.SelectionText}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/><Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type Expander}">
        <Setter Property="Background" Value="{DynamicResource Buddy.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Expander}"><StackPanel>
            <ToggleButton x:Name="header" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" MinHeight="44" FocusVisualStyle="{x:Null}">
                <ToggleButton.Template><ControlTemplate TargetType="{x:Type ToggleButton}"><Border x:Name="focusRing" BorderThickness="3" BorderBrush="Transparent"><Border x:Name="focusGap" BorderThickness="3" BorderBrush="Transparent"><Border x:Name="frame" Background="{TemplateBinding Background}" Padding="8"><DockPanel><TextBlock x:Name="chevron" Text="›" Width="24" FontSize="20" Foreground="{TemplateBinding Foreground}"/><ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></DockPanel></Border></Border></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="chevron" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource Buddy.FocusRing}"/><Setter TargetName="focusGap" Property="BorderBrush" Value="{DynamicResource Buddy.FocusGap}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Buddy.DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="body" Visibility="Collapsed" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type Hyperlink}"><Setter Property="Foreground" Value="{DynamicResource Buddy.Deep}"/><Setter Property="TextDecorations" Value="Underline"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Buddy.DisabledText}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="{x:Type Separator}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Separator}"><Border Height="1" Margin="6,3" Background="{DynamicResource Buddy.Line}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="{x:Type ProgressBar}"><Setter Property="Background" Value="{DynamicResource Buddy.Input}"/><Setter Property="Foreground" Value="{DynamicResource Buddy.Deep}"/><Setter Property="BorderBrush" Value="{DynamicResource Buddy.ControlBorder}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ProgressBar}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Grid></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource Buddy.Input}"/><Setter Property="Width" Value="14"/><Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseRepeatButton><RepeatButton x:Name="before" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="{DynamicResource Buddy.Input}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb MinHeight="20" MinWidth="10"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border x:Name="thumb" Background="{DynamicResource Buddy.ControlBorder}" CornerRadius="5" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="thumb" Property="Background" Value="{DynamicResource Buddy.FocusRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton x:Name="after" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="{DynamicResource Buddy.Input}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            </Track></Grid>
            <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="before" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="after" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="14"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
